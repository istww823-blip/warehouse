from mido import Message, MidiFile, MidiTrack, MetaMessage

# Membuat MIDI sederhana dari chord progression G-D-Em-C (16 bar)
mid = MidiFile()
track = MidiTrack()
mid.tracks.append(track)

# Tempo 90bpm
track.append(MetaMessage('set_tempo', tempo=600000))

# Chord progression G-D-Em-C, 4 beats per chord
chords = [
    ['G3', 'B3', 'D4'], 
    ['D3', 'F#3', 'A3'], 
    ['E3', 'G3', 'B3'], 
    ['C3', 'E3', 'G3']
]

# Mapping note names ke MIDI number
note_map = {
    'C3': 48, 'C#3':49, 'D3':50, 'D#3':51, 'E3':52, 'F3':53, 'F#3':54, 'G3':55, 'G#3':56, 'A3':57, 'A#3':58, 'B3':59,
    'C4':60, 'C#4':61, 'D4':62, 'D#4':63, 'E4':64, 'F4':65, 'F#4':66, 'G4':67, 'G#4':68, 'A4':69, 'A#4':70, 'B4':71,
    'C5':72, 'C#5':73, 'D5':74, 'D#5':75, 'E5':76, 'F5':77, 'F#5':78, 'G5':79, 'G#5':80, 'A5':81, 'A#5':82, 'B5':83
}

# Durasi 1 beat = 480 ticks
ticks_per_beat = 480
beats_per_chord = 4

# Buat 16 bar (4 chord per bar, 16 chord total)
for i in range(16):
    chord = chords[i%4]
    for note in chord:
        track.append(Message('note_on', note=note_map[note], velocity=64, time=0))
    track.append(Message('note_off', note=note_map[chord[0]], velocity=64, time=ticks_per_beat*beats_per_chord))
    for note in chord[1:]:
        track.append(Message('note_off', note=note_map[note], velocity=64, time=0))

# Simpan MIDI
midi_file_path = "easy_listening_demo.mid"
mid.save(midi_file_path)

print("MIDI demo saved as", midi_file_path)
